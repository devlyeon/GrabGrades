  m_Script: {fileID: 11500000, guid: db3e37f15fa2048fcb249c16d6969f27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextPrint
  text: {fileID: 83685680}
  strings:
  - "\uC5B4\uC11C\uC640! \uAC8C\uC784\uC744 \uC124\uBA85\uD574\uC904\uAC8C! \uAC8C\uC784
    \uBC29\uBC95\uC740 \uC544\uC8FC \uAC04\uB2E8\uD574!"
  - "\uC131\uC801\uD45C\uAC00 \uBC30\uACBD\uC5D0 \uB098\uD0C0\uB098\uBA74, \uAC00\uC7A5
    \uBA3C\uC800 \uC790\uC2E0\uC758 \uD0A4\uBCF4\uB4DC \uD0A4\uB97C \uB204\uB974\uB294
    \uC0AC\uB78C\uC774 \uC131\uC801\uD45C\uB97C \uAC00\uC838\uAC00\uB294 \uAC70\uC57C!"
  - "\uC131\uC801\uD45C\uB294 \uB2E4\uC591\uD55C \uC885\uB958\uAC00 \uC788\uB294\uB370,
    \uC88B\uC740 \uC810\uC218\uC758 \uC131\uC801\uD45C\uB97C \uAC00\uC838\uAC00\uBA74
    \uB354 \uB9CE\uC740 \uC810\uC218\uB97C \uC5BB\uC744 \uC218 \uC788\uC5B4!"
  - "\uD558\uC9C0\uB9CC \uC624\uD788\uB824 \uC810\uC218\uB97C \uC783\uAC8C \uB9CC\uB4DC\uB294
    \uC131\uC801\uD45C\uB3C4 \uC788\uC9C0! \uADF8\uB7F4 \uB550 \uD0A4\uB97C \uC548
    \uB204\uB974\uBA74 \uB3FC!"
  - "\uC790, \uC774\uC81C \uAC8C\uC784\uC744 \uC2DC\uC791\uD574\uBCFC\uAE4C?"
